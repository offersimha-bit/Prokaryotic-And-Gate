 seq:\n","    for i in range(len(sequence) - window_size + 1):\n","        window_seq = sequence[i:i + window_size]\n","\n","        # get the mfe score:\n","        structure, mfe = RNA.fold(window_seq)\n","\n","        # saving results:\n","        results.append({\n","            'start_index': i, #start index starts with 0!\n","            'sequence': window_seq,\n","            'structure': structure,\n","            'mfe': mfe\n","        })\n","\n","    # sort by high mfe to low (higher is better = not folded)\n","    sorted_results = sorted(results, key=lambda x: x['mfe'], reverse=True)\n","\n","    # get the \"top_n\"\n","    return sorted_results[:top_n]\n","\n","\n","my_long_trigger = \"\"\n","top_10 = get_top_mfe_windows(my_long_trigger, window_size=30, top_n=15)\n","\n","print(\"top 10 places in the trigger are:\")\n","for rank, result in enumerate(top_10, start=1):\n","    print(f\"place: {rank}:\")\n","    print(f\"start index: {result['start_index']}\")\n","    print(f\" the seq: {result['sequence']}\")\n","    print(f\" MFE score: {result['mfe']} kcal/mol\")\n","    print(\"-\" * 40)\n","\n","# save to csv:\n","csv_filename = \"trigger_best_mfe_results.csv\"\n","with open(csv_filename, mode='w', newline='', encoding='utf-8') as file:\n","    writer = csv.writer(file)\n","\n","    # add Headers:\n","    writer.writerow([\"Rank\", \"Start_Index\", \"Sequence\", \"Structure\", \"MFE_Score\"])\n","\n","    # add the results into the csv:\n","    for rank, result in enumerate(top_10, start=1):\n","        writer.writerow([\n","            rank,\n","            result['start_index'],\n","            result['sequence'],\n","            result['structure'],\n","            result['mfe']\n","        ])"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"EuFxTMHLgV3E","executionInfo":{"status":"ok","timestamp":1774350862710,"user_tz":-120,"elapsed":4687,"user":{"displayName":"Shani Linzish","userId":"16091877957100931263"}},"outputId":"004df338-bcdc-445a-9e37-ea172c8a3ef4"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Requirement already satisfied: ViennaRNA in /usr/local/lib/python3.12/dist-packages (2.7.2)\n","top 10 places in the trigger are:\n","place: 1:\n","start index: 439\n"," the seq: GCTGGGAGGCCTCCTCCGAGCGGATGTACC\n"," MFE score: -14.300000190734863 kcal/mol\n","----------------------------------------\n","place: 2:\n","start index: 431\n"," the seq: GACCATGGGCTGGGAGGCCTCCTCCGAGCG\n"," MFE score: -14.199999809265137 kcal/mol\n","----------------------------------------\n","place: 3:\n","start index: 432\n"," the seq: ACCATGGGCTGGGAGGCCTCCTCCGAGCGG\n"," MFE score: -14.199999809265137 kcal/mol\n","----------------------------------------\n","place: 4:\n","start index: 433\n"," the seq: CCATGGGCTGGGAGGCCTCCTCCGAGCGGA\n"," MFE score: -14.199999809265137 kcal/mol\n","----------------------------------------\n","place: 5:\n","start index: 434\n"," the seq: CATGGGCTGGGAGGCCTCCTCCGAGCGGAT\n"," MFE score: -14.199999809265137 kcal/mol\n","----------------------------------------\n","place: 6:\n","start index: 435\n"," the seq: ATGGGCTGGGAGGCCTCCTCCGAGCGGATG\n"," MFE score: -14.199999809265137 kcal/mol\n","----------------------------------------\n","place: 7:\n","start index: 436\n"," the seq: TGGGCTGGGAGGCCTCCTCCGAGCGGATGT\n"," MFE score: -14.199999809265137 kcal/mol\n","----------------------------------------\n","place: 8:\n","start index: 437\n"," the seq: GGGCTGGGAGGCCTCCTCCGAGCGGATGTA\n"," MFE score: -14.199999809265137 kcal/mol\n","----------------------------------------\n","place: 9:\n","start index: 438\n"," the seq: GGCTGGGAGGCCTCCTCCGAGCGGATGTAC\n"," MFE score: -14.199999809265137 kcal/mol\n","----------------------------------------\n","place: 10:\n","start index: 207\n"," the seq: TTCATGTACGGCTCCAAGGCCTACGTGAAG\n"," MFE score: -13.699999809265137 kcal/mol\n","----------------------------------------\n","place: 11:\n","start index: 664\n"," the seq: CCGAGGGCCGCCACTCCACCGGCGGCATGG\n"," MFE score: -13.5 kcal/mol\n","----------------------------------------\n","place: 12:\n","start index: 670\n"," the seq: GCCGCCACTCCACCGGCGGCATGGACGAGC\n"," MFE score: -13.5 kcal/mol\n","----------------------------------------\n","place: 13:\n","start index: 661\n"," the seq: GCGCCGAGGGCCGCCACTCCACCGGCGGCA\n"," MFE score: -13.199999809265137 kcal/mol\n","----------------------------------------\n","place: 14:\n","start index: 662\n"," the seq: CGCCGAGGGCCGCCACTCCACCGGCGGCAT\n"," MFE score: -13.199999809265137 kcal/mol\n","----------------------------------------\n","place: 15:\n","start index: 663\n"," the seq: GCCGAGGGCCGCCACTCCACCGGCGGCATG\n"," MFE score: -13.199999809265137 kcal/mol\n","----------------------------------------\n"]}]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"bin_-TkWCjPs","executionInfo":{"status":"ok","timestamp":1774359889489,"user_tz":-120,"elapsed":75133,"user":{"displayName":"Shani Linzish","userId":"16091877957100931263"}},"outputId":"59f8bd9e-3f7b-4e6c-e1b5-cc39567f9b47"},"outputs":[{"output_type":"stream","name":"stdout","text":["All switches saved in designed_switches_results.csv\n","All trial defect plots were saved in a single file: all_defect_plots.pdf\n"]}],"source":["import csv\n","import matplotlib.pyplot as plt # NEW: For plotting the bar charts\n","from typing import Tuple\n","from Bio.Seq import Seq\n","from nupack import *\n","\n","config.threads = 8 # Sets the number of CPU threads allocated for NUPACK's calculations.\n","\n","RBS_SEQUENCE = \"AACAGAGGAGA\" # Ribosome binding sequence\n","STOP_CODONS = ['UGA', 'UAG', 'UAA']\n","FORBIDDEN_PATTERNS = [\"AAAA\", \"CCCC\", \"GGGG\", \"UUUU\", \"KKKKKK\", \"MMMMMM\", \"RRRRRR\", \"SSSSSS\", \"WWWWWW\", \"YYYYYY\"]\n","START_CODON = \"AUG\"\n","\n","# the linker Daniel gave me:\n","\n","class ProkaryoticSwitchGenerator:\n","    SEED = 42 # ensures reproducibility (the same inputs in every running)\n","\n","    def __init__(self, translated_gene_sequence: str, leader_sequence: str = \"GGG\",\n","                 a_domain_size: int = 12, b_domain_size_pre_bulge: int = 9, b_domain_size_post_bulge: int = 6,\n","                 loop_size: int = 11, linker_pattern: str = \"AACCUGGCGGCAGCGCAAAAG\",\n","                 nucleotides_count_to_trim_gene_after: int = 30, trigger_length: int = 30):\n","        self.model = Model(material='rna', celsius=37)\n","        self.translated_gene_sequence = translated_gene_sequence[3:nucleotides_count_to_trim_gene_after+3]  # remove the AUG\n","        self.b_domain_size_pre_bulge = b_domain_size_pre_bulge\n","        self.b_domain_size_post_bulge = b_domain_size_post_bulge\n","        self.a_domain_size = a_domain_size\n","        self.loop_size = loop_size\n","        self.trigger_length = trigger_length\n","\n","        self.leader = Domain(leader_sequence, name=\"leader\", material=\"rna\")\n","        self.linker = Domain(linker_pattern, name=\"linker\", material=\"rna\")\n","        # CHANGED: We don't need the gene domain anymore for the NUPACK design\n","        # self.translated_gene = Domain(self.translated_gene_sequence, name=\"translated gene\", material=\"rna\")\n","\n","        assert loop_size >= len(RBS_SEQUENCE), \"loop size must be larger than the RBS length\"\n","\n","        self.loop = Domain(f\"N{loop_size - len(RBS_SEQUENCE)}{RBS_SEQUENCE}\", name=\"loop\", material=\"rna\")\n","        self.bulge = Domain(f\"{START_CODON}\", name=\"bulge\", material=\"rna\")\n","\n","        # CHANGED: Target structure ends exactly after the linker (removed the gene dots)\n","        self.switch_structure = (f\".{len(leader_sequence)}.{a_domain_size}({b_domain_size_pre_bulge}\"\n","                                 f\".{len(START_CODON)}({b_domain_size_post_bulge}\"\n","                                 f\".{loop_size}){b_domain_size_post_bulge}.{len(START_CODON)}\"\n","                                 f\"){b_domain_size_pre_bulge}\"\n","                                 f\".{len(linker_pattern)}\")\n","\n","        self.patterns_to_prevent = Pattern(FORBIDDEN_PATTERNS)\n","        self.options = DesignOptions(f_stop=0.01, seed=self.SEED, wobble_mutations=True)\n","        self.complex_name = 'activated_complex'\n","\n","    @property\n","    def prescribed_stem_structure(self):\n","        return (f\"({self.b_domain_size_pre_bulge}\"\n","                f\".{len(START_CODON)}({self.b_domain_size_post_bulge}\"\n","                f\".{self.loop_size}){self.b_domain_size_post_bulge}.{len(START_CODON)}\"\n","                f\"){self.b_domain_size_pre_bulge}\")\n","\n","    def get_switches(self, trigger_sequence: str, healthy_sequence: str = None,\n","                     is_watson_crick: bool = True, num_trials: int = 15, top_k: int = 5):\n","\n","        assert len(trigger_sequence) == self.trigger_length\n","\n","        trigger_domain = Domain(trigger_sequence, name=\"trigger domain\", material='rna')\n","        trigger = TargetStrand([trigger_domain], name=\"trigger\")\n","        trigger_structure = \".\" * len(trigger_sequence)\n","        trigger_complex = TargetComplex([trigger], trigger_structure, name='trigger complex')\n","\n","        if is_watson_crick:\n","            trigger_reverse_complement = str(Seq(trigger_sequence).reverse_complement_rna())\n","            a_domain = Domain(f\"{trigger_reverse_complement[:self.a_domain_size]}\", name=\"a\", material=\"rna\")\n","            b_domain_pre_bulge = Domain(\n","                f\"{trigger_reverse_complement[self.a_domain_size:self.a_domain_size + self.b_domain_size_pre_bulge]}{'N' * max(0, self.b_domain_size_pre_bulge - len(trigger_reverse_complement[self.a_domain_size:]))}\",\n","                name=\"b_domain_pre_bulge\", material=\"rna\")\n","            b_domain_bulge = Domain(\n","                f\"{trigger_reverse_complement[self.a_domain_size + self.b_domain_size_pre_bulge:self.a_domain_size + self.b_domain_size_pre_bulge + len(START_CODON)]}{'N' * max(0, len(START_CODON) - len(trigger_reverse_complement[self.a_domain_size + self.b_domain_size_pre_bulge:]))}\",\n","                name=\"b_domain_bulge\", material=\"rna\")\n","            b_domain_post_bulge = Domain(\n","                f\"{trigger_reverse_complement[self.a_domain_size + self.b_domain_size_pre_bulge + len(START_CODON):self.a_domain_size + self.b_domain_size_pre_bulge + len(START_CODON) + self.b_domain_size_post_bulge]}{'N' * max(0, self.b_domain_size_post_bulge - len(trigger_reverse_complement[self.a_domain_size + self.b_domain_size_pre_bulge + len(START_CODON):]))}\",\n","                name=\"b_domain_post_bulge\", material=\"rna\")\n","        else:\n","            a_domain = Domain(f\"N{self.a_domain_size}\", name=\"a\", material=\"rna\")\n","            b_domain_pre_bulge = Domain(f\"N{self.b_domain_size_pre_bulge}\", name=\"b_domain_pre_bulge\", material=\"rna\")\n","            b_domain_bulge = Domain(f\"N{len(START_CODON)}\", name=\"b_domain_bulge\", material=\"rna\")\n","            b_domain_post_bulge = Domain(f\"N{self.b_domain_size_post_bulge}\", name=\"b_domain_post_bulge\", material=\"rna\")\n","\n","        # CHANGED: Removed self.translated_gene from the end of the strand\n","        switch = TargetStrand([\n","            self.leader, a_domain, b_domain_pre_bulge, b_domain_bulge, b_domain_post_bulge,\n","            self.loop, ~b_domain_post_bulge, self.bulge, ~b_domain_pre_bulge, self.linker\n","          ], name=\"switch\")\n","\n","        switch_complex = TargetComplex([switch], self.switch_structure, name='switch complex')\n","\n","        if healthy_sequence:\n","            healthy_sequence_domain = Domain(healthy_sequence, name=\"healthy trigger domain\", material='rna')\n","            healthy_trigger = TargetStrand([healthy_sequence_domain], name=\"healthy trigger\")\n","            healthy_trigger_structure = \".\" * len(healthy_sequence)\n","            healthy_trigger_complex = TargetComplex([healthy_trigger], healthy_trigger_structure, name='healthy trigger complex')\n","\n","        activated_structure = self._get_activated_structure(switch)\n","        activated_complex = TargetComplex([trigger, switch], activated_structure, name=self.complex_name)\n","\n","        reactants = TargetTube(on_targets={switch_complex: 1e-08, trigger_complex: 1e-08},\n","                               off_targets=SetSpec(max_size=2, exclude=tuple([activated_complex])), name='reactants')\n","\n","        if healthy_sequence:\n","            off_target_reactants = TargetTube(on_targets={switch_complex: 1e-08, healthy_trigger_complex: 1e-08},\n","                                              off_targets=SetSpec(max_size=2), name='off_target_reactants')\n","            tubes = [reactants, products, off_target_reactants]\n","        else:\n","            products = TargetTube(on_targets={activated_complex: 1e-08}, off_targets=SetSpec(max_size=2), name='products')\n","            tubes = [reactants, products]\n","\n","        my_design = tube_design(tubes=tubes, hard_constraints=[], soft_constraints=[], model=self.model, options=self.options)\n","\n","        all_design_results = my_design.run(trials=num_trials)\n","\n","        # NEW: Extract raw defects in their original trial order BEFORE sorting\n","        raw_defects = [self._get_ensemble_defect(trial) for trial in all_design_results]\n","\n","        # sort by Ensemble Defect score- lower is better\n","        sorted_results = sorted(all_design_results, key=lambda trial: self._get_ensemble_defect(trial))\n","\n","        # get the top k:\n","        top_results = sorted_results[:top_k]\n","\n","        # get the data on each of top k switches:\n","        best_switches_data = []\n","        for switch_res in top_results:\n","            switch_designed_strand = [v for k, v in switch_res.to_analysis.strands.items() if v.name == \"switch\"].pop()\n","            ensemble_defect = self._get_ensemble_defect(switch_res)\n","            complex_concentration = self._get_trigger_switch_complex_concentration(switch_res, self.complex_name)\n","            switch_mfe_structure = self._get_switch_mfe_structure(switch_res, switch_complex)\n","\n","            best_switches_data.append({\n","                \"sequence\": str(switch_designed_strand),\n","                \"defect\": ensemble_defect,\n","                \"yield\": complex_concentration,\n","                \"mfe_structure\": switch_mfe_structure\n","            })\n","\n","        return best_switches_data, raw_defects # CHANGED: returning the raw defects too\n","\n","    def _get_activated_structure(self, switch) -> str:\n","        return ('(' * self.trigger_length + '+' + '.' * self.leader.nt() + ')' * self.trigger_length +\n","                '.' * (switch.nt() - self.leader.nt() - self.trigger_length))\n","\n","    def _get_ensemble_defect(self, design_result) -> float:\n","        return design_result.defects.ensemble_defect\n","\n","    def _get_trigger_switch_complex_concentration(self, design_result, complex_name) -> float:\n","        complex_concentrations = design_result.concentrations.table[\n","            design_result.concentrations.table.complex_name == complex_name].iloc[0]\n","        target_concentration = complex_concentrations[\"target_concentration\"]\n","        predicted_concentration = complex_concentrations[\"concentration\"]\n","        return predicted_concentration / target_concentration\n","\n","    def _get_switch_mfe_structure(self, design_result, switch_target_strand) -> str:\n","        return str(mfe(strands=design_result.to_analysis(switch_target_strand), model=self.model)[0].structure)\n","\n","\n","# running the generator:\n","if __name__ == \"__main__\":\n","    from matplotlib.backends.backend_pdf import PdfPages # NEW: ייבוא כלי לשמירת PDF\n","\n","    # If we want to use GFP, replace this with the full GFP sequence!\n","    my_gene = \"AUGCGUAAAGGAGAAGAACUUUUCACUGGAGUUGUCCCAAUUCUUGUUGAAUUAGAUGGUGAUGUUAAUGGG\"\n","\n","    generator = ProkaryoticSwitchGenerator(\n","        translated_gene_sequence=my_gene,\n","        trigger_length=30)\n","\n","    # full trigger m-cherry (converted to RNA):\n","    full_trigger = \"\".replace(\"T\", \"U\")\n","\n","    # top indices of the trigger- from \"trigger_mfe_results\" file:\n","    top_trigger_indices = [236, 237, 238, 239, 240, 241, 232, 233, 234, 235, 0, 1, 2, 16, 231]\n","\n","    csv_filename = \"designed_switches_results.csv\"\n","    pdf_filename = \"all_defect_plots.pdf\"\n","\n","    # creates csv+ pdf files\n","    with open(csv_filename, mode='w', newline='', encoding='utf-8') as file, PdfPages(pdf_filename) as pdf:\n","        writer = csv.writer(file)\n","        writer.writerow([\"Trigger_Start_Index\", \"Trigger_Sequence\", \"Switch_Rank\", \"Switch_RNA_Sequence\", \"Predicted_MFE_Structure\", \"Ensemble_Defect\", \"Activation_Yield\"])\n","\n","        for start_index in top_trigger_indices:\n","            my_trigger = full_trigger[start_index : start_index + 30]\n","\n","            # CHANGED: Unpacking the two variables returned by the function\n","            top_switches, raw_defects = generator.get_switches(\n","                trigger_sequence=my_trigger,\n","                num_trials=50,\n","                top_k=5\n","            )\n","\n","            # creating graph\n","            plt.figure(figsize=(10, 5))\n","            plt.bar(range(1, len(raw_defects) + 1), raw_defects, color='skyblue')\n","            plt.xlabel('Trial Index')\n","            plt.ylabel('Ensemble Defect')\n","            plt.title(f'Ensemble Defect per Trial (Trigger Index {start_index})')\n","\n","            pdf.savefig() # saves pdf with all the garphs\n","            plt.close()\n","\n","            for rank, switch_data in enumerate(top_switches, start=1):\n","                writer.writerow([\n","                    start_index,\n","                    my_trigger,\n","                    rank,\n","                    switch_data['sequence'],\n","                    switch_data['mfe_structure'],\n","                    switch_data['defect'],\n","                    f\"{switch_data['yield']:.2%}\"\n","                ])\n","\n","        print(f\"All switches saved in {csv_filename}\")\n","        print(f\"All trial defect plots were saved in a single file: {pdf_filename}\")"]}]}